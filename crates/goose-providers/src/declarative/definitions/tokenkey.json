{
  "name": "tokenkey",
  "engine": "openai",
  "display_name": "TokenKey",
  "description": "Loukri AI inference on tokenkey.in (OpenAI-compatible)",
  "api_key_env": "TOKENKEY_API_KEY",
  "base_url": "https://tokenkey.in/v1/chat/completions",
  "models": [
    {
      "name": "tk-auto",
      "context_limit": 32768,
      "max_tokens": 8192
    },
    {
      "name": "tk-base",
      "context_limit": 65536,
      "max_tokens": 8192
    },
    {
      "name": "tk-reason",
      "context_limit": 65536,
      "max_tokens": 8192
    }
  ],
  "supports_streaming": true,
  "dynamic_models": false,
  "model_doc_link": "https://tokenkey.in/docs",
  "setup_steps": [
    "Sign in at tokenkey.in and create an API key in the console",
    "Keys start with tk_live_ and are shown only once \u2014 store them safely",
    "Paste the key below to connect"
  ],
  "setup": {
    "category": "model",
    "setup_method": "single_api_key",
    "group": "default",
    "docs_url": "https://tokenkey.in/docs"
  }
}
